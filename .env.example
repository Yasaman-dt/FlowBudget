# Copy to a local shell setup or export these variables before launching scripts.
# This file is not loaded automatically. Set paths to locations on your machine.
export FLOWBUDGET_IMAGENET=/path/to/imagenet/train
export FLOWBUDGET_CIFAR10=/path/to/cifar10
export FLOWBUDGET_RF_CHECKPOINTS=/path/to/rf/checkpoints
export FLOWBUDGET_UNET_CHECKPOINTS=/path/to/unet/checkpoints
export FLOWBUDGET_FLOWDCN_CHECKPOINTS=/path/to/flowdcn/checkpoints
export FLOWBUDGET_SIT_CHECKPOINT=/path/to/SiT-XL-2-256x256.pt
export FLOWBUDGET_EVALUATOR=/path/to/guided-diffusion/evaluations/evaluator.py
export FLOWBUDGET_CIFAR_REFERENCE=/path/to/cifar10_test_10k.npz
export FLOWBUDGET_IMAGENET_REFERENCE=/path/to/imagenet_train_10k_center_crop_256.npz
export CUDA_VISIBLE_DEVICES=0
# Optional: single-device estimators and RF samplers accept --device as well.
export FLOWBUDGET_DEVICE=cuda
# Optional: shell launchers otherwise use python from the active environment.
export FLOWBUDGET_PYTHON=python
